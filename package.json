{
  "name": "@nevysha/ui",
  "version": "0.3.0",
  "private": true,
  "description": "Nevysha's React design system: tokens, components, Storybook.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills",
    "bin",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./font.css": "./dist/font.css"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "bin": {
    "nevysha-ui-skill": "./bin/install-skill.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nevysha/design-system.git"
  }
}
